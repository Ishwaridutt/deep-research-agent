# =========================================================
# Application
# =========================================================

APP_NAME=Deep Research Agent
APP_ENV=development
DEBUG=true


# =========================================================
# OpenAI
# =========================================================

OPENAI_API_KEY=
GROQ_API_KEY=your-key

# Keep model selection configurable.
# You can initially use the same model for every role.
PLANNER_MODEL=
QUERY_GENERATOR_MODEL=
EVIDENCE_MODEL=
COVERAGE_MODEL=
WRITER_MODEL=
CITATION_MODEL=

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

GRAPH_RECURSION_LIMIT=50

RETRIEVAL_CHUNK_SIZE=400
RETRIEVAL_TOP_K=6
RETRIEVAL_MAX_CONTEXT_TOKENS=3000
RETRIEVAL_EMBEDDING_DEVICE=cpu


# =========================================================
# Tavily
# =========================================================

TAVILY_API_KEY=

SEARCH_PROVIDER=tavily
WEB_EXTRACTOR_PROVIDER=tavily

SEARCH_TIMEOUT_SECONDS=20
EXTRACTION_TIMEOUT_SECONDS=30

TAVILY_EXTRACT_DEPTH=basic
TAVILY_EXTRACT_FORMAT=markdown


# =========================================================
# Research limits
# =========================================================

MAX_QUESTION_CHARS=10000

MAX_SUBQUESTIONS=5

MAX_QUERIES_PER_SUBQUESTION=3
MAX_SEARCH_QUERY_CHARS=500
MAX_TOTAL_QUERIES_PER_JOB=30

MAX_SEARCH_RESULTS_PER_QUERY=5

MAX_SOURCE_DOWNLOAD_BYTES=5000000
MAX_SOURCE_CONTENT_CHARS=50000

MIN_EVIDENCE_RELEVANCE=0.60
MAX_EVIDENCE_ITEMS=100

MAX_ITERATIONS=3

# =========================================================
# Writer context limits
# =========================================================

MAX_WRITER_EVIDENCE_ITEMS=40
MAX_WRITER_EVIDENCE_CHARS=30000


# =========================================================
# Future file-upload limits
# Phase 3 - not active yet
# =========================================================

MAX_FILES_PER_REQUEST=10
MAX_FILE_SIZE_MB=20
MAX_TOTAL_UPLOAD_SIZE_MB=50


# =========================================================
# Future voice limits
# Phase 5 - not active yet
# =========================================================

MAX_AUDIO_DURATION_SECONDS=300
MAX_AUDIO_SIZE_MB=25


# =========================================================
# Observability
# =========================================================

LOG_LEVEL=INFO

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deep-research-agent



