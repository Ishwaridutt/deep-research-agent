# =========================================================
# Application
# =========================================================

APP_NAME=Deep Research Agent
APP_ENV=development
DEBUG=true


# =========================================================
# OpenAI
# =========================================================

OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=your-key

# Each role accepts a comma-separated provider:model fallback chain.
# Example: openai:<model>,google_genai:<model>,groq:<model>
LLM_PROVIDER=groq
LLM_PROVIDER_ORDER=openai,google_genai,groq
LLM_PRIVATE_DATA_PROVIDERS=openai,google_genai,groq
PLANNER_MODEL=
QUERY_GENERATOR_MODEL=
EVIDENCE_MODEL=
COVERAGE_MODEL=
WRITER_MODEL=
CITATION_MODEL=

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_STRUCTURED_OUTPUT_METHOD=json_schema
LLM_STRUCTURED_OUTPUT_ATTEMPTS=2

GRAPH_RECURSION_LIMIT=50

RETRIEVAL_CHUNK_SIZE=400
RETRIEVAL_TOP_K=6
RETRIEVAL_MAX_CONTEXT_TOKENS=3000
RETRIEVAL_EMBEDDING_DEVICE=cpu


# =========================================================
# Tavily
# =========================================================

TAVILY_API_KEY=
BRAVE_API_KEY=
FIRECRAWL_API_KEY=

SEARCH_PROVIDER=tavily
WEB_EXTRACTOR_PROVIDER=tavily

SEARCH_TIMEOUT_SECONDS=20
EXTRACTION_TIMEOUT_SECONDS=30

TAVILY_EXTRACT_DEPTH=basic
TAVILY_EXTRACT_FORMAT=markdown
BRAVE_API_URL=https://api.search.brave.com/res/v1/web/search
BRAVE_API_VERSION=2023-01-01
FIRECRAWL_API_URL=https://api.firecrawl.dev/v2/scrape
PROVIDER_MAX_RETRIES=1
PROVIDER_RETRY_DELAY_SECONDS=0.25
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=2
PROVIDER_CIRCUIT_RECOVERY_SECONDS=60

ARXIV_ENABLED=true
WIKIPEDIA_ENABLED=true
ARXIV_API_URL=https://export.arxiv.org/api/query
WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php
PUBLIC_API_USER_AGENT=DeepResearchAgent/0.1
ARXIV_TIMEOUT_SECONDS=20
WIKIPEDIA_TIMEOUT_SECONDS=20
ARXIV_FULL_TEXT_ENABLED=true
ARXIV_MAX_PDF_PAGES=20
SEARCH_MAX_CONCURRENCY=3
WEB_RESULTS_PER_QUERY=5
ARXIV_RESULTS_PER_QUERY=3
WIKIPEDIA_RESULTS_PER_QUERY=3


# =========================================================
# Research limits
# =========================================================

MAX_QUESTION_CHARS=10000

MAX_SUBQUESTIONS=5

MAX_QUERIES_PER_SUBQUESTION=3
MAX_SEARCH_QUERY_CHARS=500
MAX_TOTAL_QUERIES_PER_JOB=30

MAX_SEARCH_RESULTS_PER_QUERY=5

MAX_SOURCE_DOWNLOAD_BYTES=5000000
MIN_SOURCE_CONTENT_CHARS=80
MAX_SOURCE_CONTENT_CHARS=50000

MIN_EVIDENCE_RELEVANCE=0.60
MAX_EVIDENCE_ITEMS=100

MAX_ITERATIONS=3

# =========================================================
# Writer context limits
# =========================================================

MAX_WRITER_EVIDENCE_ITEMS=40
MAX_WRITER_EVIDENCE_CHARS=30000


# =========================================================
# Future file-upload limits
# Phase 3 - not active yet
# =========================================================

MAX_FILES_PER_REQUEST=10
MAX_FILE_SIZE_MB=20
MAX_TOTAL_UPLOAD_SIZE_MB=50


# =========================================================
# Future voice limits
# Phase 5 - not active yet
# =========================================================

MAX_AUDIO_DURATION_SECONDS=300
MAX_AUDIO_SIZE_MB=25


# =========================================================
# Observability
# =========================================================

LOG_LEVEL=INFO

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deep-research-agent



